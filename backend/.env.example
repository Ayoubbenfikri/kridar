APP_NAME=Krihouse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kridar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# React (Vite) dev server origin(s) allowed to call this API.
# Comma-separated if you ever need more than one.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost,127.0.0.1

# --- "Connect with Google" (config/services.php, GoogleAuthController) ----
# From Google Cloud Console -> APIs & Services -> Clients -> your OAuth
# Client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match one of the "Authorized redirect URIs" entered there exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# ----------------------------------------------------------------------

# --- Payments ---------------------------------------------------------
# Is Krihouse charging for anything at all?
#
# false (the default) = FREE MODE, the launch position. No long-term
# publication fee, no commission on bookings, every payment endpoint
# refuses, and the interface advertises "gratuit" instead of a price.
# Nothing is deleted: flip this to true and the whole paid model from
# Phases 22-25 comes back exactly as it was.
#
# Run `php artisan config:clear` after changing it.
PAYMENTS_ENABLED=false

# Which gateway is bound to PaymentGatewayInterface (config/payments.php).
# Only consulted once PAYMENTS_ENABLED=true:
#   fake    FakeCmiGateway - no network, always succeeds. Keep this while
#           running the test-*.ps1 scripts.
#   paypal  PaypalGateway  - real PayPal Orders v2 calls.
PAYMENT_GATEWAY=fake

# Sandbox host. Live is https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# From developer.paypal.com -> Apps & Credentials -> Sandbox.
# NEVER commit real values; they belong in .env only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal does not accept MAD. Amounts are converted to this currency
# using the admin-configurable rate (mad_to_paypal_rate in /admin/settings).
PAYPAL_CURRENCY=EUR
PAYPAL_TIMEOUT=20
# ----------------------------------------------------------------------

# --- Donations (config/support.php) -----------------------------------
# Krihouse is free, so /support is where people who want to help can.
# EVERY field is optional and an empty one simply does not render, so you
# can start with one method and add others later without touching code.
#
# These are all PUBLIC - they are served by GET /settings and shown in the
# browser. A donation link or a bank account number belongs here; an API
# key or a password never does.
#
# PayPal.Me - your HANDLE ONLY, no https:// and no paypal.me/ prefix.
#   DONATE_PAYPAL_ME=ayoubbenfikri   ->  paypal.me/ayoubbenfikri
# Filling this in gives /support a row of preset amount buttons plus an
# "other amount" link. No credentials, no API: PayPal.Me takes the amount
# in the URL, and the payment happens entirely on paypal.com.
DONATE_PAYPAL_ME=

# Currency for those preset amounts. NEVER MAD - PayPal does not support
# the dirham, and an unsupported code makes the link silently fall back to
# your account default, so the button would request an amount nobody chose.
DONATE_CURRENCY=EUR

# Any OTHER provider (Ko-fi, Buy Me a Coffee, Patreon...). Leave empty if
# PayPal above is your only method; both can be set and both will show.
# Check the provider actually pays out where you are before settling on
# one - that is a provider constraint, not a code one, which is why the
# manual methods below exist.
DONATE_URL=

# A plain bank transfer, for people who would rather skip a platform.
DONATE_BANK_LABEL=
DONATE_BANK_DETAILS=

# A crypto address - works regardless of which countries a platform serves.
DONATE_CRYPTO_LABEL=
DONATE_CRYPTO_ADDRESS=

# For anyone who wants to help some other way (hosting, translation, bugs).
DONATE_CONTACT_EMAIL=
# ----------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
